keys-plain: ["get","set","enumerable","configurable"]
flags-plain: [false,false,true,"function"]
fresh: true
fresh-after-mutation: "function"
keys-both: ["get","set","enumerable","configurable"]
flags-both: [false,true,"function","function"]
