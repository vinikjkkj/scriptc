-process.send!({ ready: true })
+// The port arrives on argv (and BENCH_RPC_PORT as a belt-and-braces
+// second spelling). Connecting is the LAST thing this file does: the
+// parent treats the connection plus a `{ready:true}` frame as the signal
+// that the child is up, and it times out rather than hanging if neither
+// arrives.
+const portText = process.argv[2] ?? process.env.BENCH_RPC_PORT
+const port = Number(portText)
+if (!Number.isFinite(port) || port <= 0) {
+    console.error(
+        `[server-process] no control-channel port: pass it as argv[2] or BENCH_RPC_PORT (got ${String(portText)})`
+    )
+    process.exit(2)
+}
+
+const sock = connect(port, '127.0.0.1', () => {
+    sock.setNoDelay(true)
+    channel = sock
+    channelSend({ ready: true })
+})
+sock.on('data', (chunk: Buffer) => {
+    for (const frame of channelReader.push(chunk)) {
+        // Same honesty as the parent's half: a notification (pairingMaterial)
+        // carries no id, so the parsed shape must allow its absence.
+        void onFrame(JSON.parse(frame.json) as RpcRequest, frame.blobs)
+    }
+})
+sock.on('error', (err: Error) => {
+    console.error(`[server-process] control channel error: ${err.message}`)
+    process.exit(3)
+})
+sock.on('close', () => {
+    // The parent went away; nothing left to serve.
+    process.exit(0)
+})
