# Block mongoasync environment. Dot-source before ANY build/test/gate.
$env:TMP    = "<blocks>\mongoasync\tmp"
$env:TEMP   = "<blocks>\mongoasync\tmp"
$env:TMPDIR = "<blocks>\mongoasync\tmp"
$env:SCRIPTC_CACHE_DIR        = "<blocks>\mongoasync\cache"
$env:npm_config_cache         = "<blocks>\mongoasync\npmcache"
$env:SCRIPTC_PROVENANCE_CACHE = "<blocks>\mongoasync\prov"
$env:ZIG_LOCAL_CACHE_DIR      = "<blocks>\mongoasync\zig"
$env:ZIG_GLOBAL_CACHE_DIR     = "<blocks>\mongoasync\zig-g"
$env:USERPROFILE = "<home>"
$env:SCRIPTC_TARGET = "x86_64-windows-gnu"
$env:SCRIPTC_CC = "zigcc"
$env:SCRIPTC_TEST_CC = "zig cc"
$env:SCRIPTC_TEST_WORKERS = "3"

$nodeVer = if ($env:MA_NODE) { $env:MA_NODE } else { "v22.18.0" }
$nodeDir = "<home>\AppData\Local\nvm\$nodeVer"

$hostPath = [Environment]::GetEnvironmentVariable("PATH", "User") + ";" +
            [Environment]::GetEnvironmentVariable("PATH", "Machine")
$env:PATH = (@(
  $nodeDir,
  "<zapo-work>\tools\zig",
  "C:\Program Files\Git\usr\bin",
  "C:\msys64\ucrt64\bin",
  "C:\Windows\System32",
  "C:\Windows",
  "C:\Windows\System32\Wbem",
  "C:\Windows\System32\WindowsPowerShell\v1.0",
  "C:\Program Files\Git\cmd"
) + ($hostPath -split ';' | Where-Object { $_ -ne '' })) -join ';'
Set-Location <blocks>\mongoasync\work
